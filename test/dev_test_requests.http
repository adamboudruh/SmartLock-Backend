### ============================================================
###  KEYS
### ============================================================

# Get all keys
GET http://localhost:3000/keys HTTP/1.1
content-type: application/json

###

# Register a new key - Yellow
POST http://localhost:3000/keys/register HTTP/1.1
content-type: application/json

{
    "name": "Yellow key",
    "tagUid": "04AB0A613E6180"
}

###

# Register a new key - Yellow-hashed
POST http://localhost:3000/keys/register HTTP/1.1
content-type: application/json

{
    "name": "Yellow key (hashed)",
    "tagUid": "bd4fd20d3223a0d2cdf50643021ca08026c32690620a91a19c86640f2d265313"
}

###

# Register a new key - Red
POST http://localhost:3000/keys/register HTTP/1.1
content-type: application/json

{
    "name": "Red key",
    "tagUid": "04C9B7603E6180"
}

###

# Register a new key - Green
POST http://localhost:3000/keys/register HTTP/1.1
content-type: application/json

{
    "name": "Green key",
    "tagUid": "046AF0603E6180"
}

###

# Delete a key by ID
DELETE http://localhost:3000/keys/:id HTTP/1.1
content-type: application/json

###

# Force whitelist sync to ESP32
POST http://localhost:3000/keys/sync HTTP/1.1
content-type: application/json


### ============================================================
###  EVENTS
### ============================================================

# Get all events
GET http://localhost:3000/events HTTP/1.1
content-type: application/json

###

# Clear all events
DELETE http://localhost:3000/events HTTP/1.1
content-type: application/json


### ============================================================
###  DEVICES
### ============================================================

# Get current device state (isLocked, isAjar, online)
GET http://localhost:3000/devices/state HTTP/1.1
content-type: application/json

###

# Send lock command to ESP32
POST http://localhost:3000/devices/lock HTTP/1.1
content-type: application/json

###

# Send unlock command to ESP32
POST http://localhost:3000/devices/unlock HTTP/1.1
content-type: application/json


### ============================================================
###  REMOTE (PRODUCTION)
### ============================================================

# Get all keys - remote backend
GET https://smartlock-backend-ezhcfahsavavfehu.canadacentral-01.azurewebsites.net/keys HTTP/1.1
content-type: application/json

###

# Get all keys - remote DB API
GET https://smartlock-db-api-cffjc8fthjfwb9hu.canadacentral-01.azurewebsites.net/keys HTTP/1.1
content-type: application/json

###

# Get device state - remote backend
GET https://smartlock-backend-ezhcfahsavavfehu.canadacentral-01.azurewebsites.net/devices/state HTTP/1.1
content-type: application/json


### ============================================================
###  DB API DIRECT (LOCAL) - bypass express backend
### ============================================================

# Get device secret
GET https://localhost:7110/devices/e3710331-5dcf-464e-9c6f-2d70f9fc277f/secret
content-type: application/json

###

# Get all keys
GET https://localhost:7110/keys HTTP/1.1
content-type: application/json

###

# Get all events
GET https://localhost:7110/events HTTP/1.1
content-type: application/json

###

# Insert event directly
POST https://localhost:7110/events HTTP/1.1
content-type: application/json

{
    "eventTypeId": 1
}

###

# Clear all events directly
DELETE https://localhost:7110/events HTTP/1.1
content-type: application/json